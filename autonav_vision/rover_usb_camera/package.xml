<?xml version="1.0"?>
<package format="3">
  <name>rover_usb_camera</name>
  <version>0.1.0</version>
  <description>Publish GStreamer JPEG camera frames to ROS 2.</description>
  <maintainer email="maintainer@example.com">Camera team (replace before distribution)</maintainer>
  <license>TODO</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <build_depend>pkg-config</build_depend>
  <build_depend>libgstreamer-plugins-base1.0-dev</build_depend>
  <exec_depend>gstreamer1.0-plugins-base</exec_depend>
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>
  <exec_depend>gstreamer1.0-plugins-bad</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>

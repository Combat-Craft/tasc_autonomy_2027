<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- This is how you comment in xml files-->

  <!-- You should not need to edit this block -->
  <name>sampleCppPackage</name>
  <version>0.0.0</version>
  <description>Sample C++ package for ROS 2</description>
  <maintainer email="yulim.lee@torontomu.ca">lyartemis</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Add dependencies here. IT's good to group them/comment why they're needed -->
  <!-- standard required node dependencies -->
  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>

  <!-- DEFAULTS -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<sdf version="1.8">
  <world name="rover_test">
    <physics name="default" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- Harmonic world systems. All geometry is local so Fuel downloads are unnecessary. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>43.66</latitude_deg><longitude_deg>-79.39</longitude_deg>
      <elevation>75</elevation><heading_deg>0</heading_deg>
    </spherical_coordinates>
    <scene>
      <ambient>0.58 0.58 0.58 1</ambient><background>0.72 0.78 0.85 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -1</direction>
      <diffuse>0.78 0.78 0.78 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="surface_collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="surface_visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.53 0.54 0.51 1</ambient><diffuse>0.55 0.57 0.53 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- The left wheel track meets the ramp while the right track stays level. -->
    <model name="left_track_ramp">
      <static>true</static>
      <pose>2.0 0.37 0.012 0 -0.13 0</pose>
      <link name="ramp">
        <collision name="ramp_collision"><geometry><box><size>0.85 0.32 0.08</size></box></geometry></collision>
        <visual name="ramp_visual">
          <geometry><box><size>0.85 0.32 0.08</size></box></geometry>
          <material><ambient>0.54 0.31 0.13 1</ambient><diffuse>0.78 0.42 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="sensor_target">
      <static>true</static>
      <pose>4.0 0 0.5 0 0 0</pose>
      <link name="target">
        <collision name="target_collision"><geometry><box><size>0.25 0.9 1.0</size></box></geometry></collision>
        <visual name="target_visual">
          <geometry><box><size>0.25 0.9 1.0</size></box></geometry>
          <material><ambient>0.17 0.34 0.52 1</ambient><diffuse>0.20 0.52 0.77 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

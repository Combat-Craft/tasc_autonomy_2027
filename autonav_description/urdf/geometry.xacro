<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="panel"><color rgba="0.19 0.22 0.25 1"/></material>
  <material name="metal"><color rgba="0.64 0.69 0.72 1"/></material>
  <material name="rubber"><color rgba="0.08 0.09 0.10 1"/></material>
  <material name="sensor"><color rgba="0.19 0.40 0.49 1"/></material>

  <xacro:macro name="fixed_joint" params="name parent child xyz:='0 0 0' rpy:='0 0 0'">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/><child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="mass x y z xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y + z*z)/12}" ixy="0" ixz="0"
               iyy="${mass*(x*x + z*z)/12}" iyz="0" izz="${mass*(x*x + y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_visual" params="size material xyz:='0 0 0' rpy:='0 0 0'">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${size}"/></geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="box_collision" params="size xyz:='0 0 0' rpy:='0 0 0'">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${size}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- A tube between two link-local points. Local +X follows the segment. -->
  <xacro:macro name="tube" params="start end">
    <xacro:property name="dx" value="${end[0]-start[0]}"/>
    <xacro:property name="dy" value="${end[1]-start[1]}"/>
    <xacro:property name="dz" value="${end[2]-start[2]}"/>
    <xacro:property name="length" value="${sqrt(dx*dx+dy*dy+dz*dz)}"/>
    <xacro:property name="size" value="${length} ${tube_width} ${tube_width}"/>
    <xacro:property name="center" value="${(start[0]+end[0])/2} ${(start[1]+end[1])/2} ${(start[2]+end[2])/2}"/>
    <xacro:property name="rpy" value="0 ${atan2(-dz,sqrt(dx*dx+dy*dy))} ${atan2(dy,dx)}"/>
    <xacro:box_visual size="${size}" material="metal" xyz="${center}" rpy="${rpy}"/>
    <xacro:box_collision size="${size}" xyz="${center}" rpy="${rpy}"/>
  </xacro:macro>
</robot>
